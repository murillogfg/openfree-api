new file mode 100644
index 0000000..e09ab43
--- /dev/null
+++ b/src/main/java/com/openfree_api/common/validation/CpfValidator.java
@@ -0,0 +1,70 @@
+package com.openfree_api.common.validation;
+
+/*
+ * Validação de CPF pelos dígitos verificadores.
+ * Sempre trabalhamos com os 11 números, sem pontos.
+ */
+public final class CpfValidator {
+
+    private CpfValidator() {
+    }
+
+    public static String normalize(
+            String cpf
+    ) {
+
+        if (cpf == null) {
+            return null;
+        }
+
+        return cpf.replaceAll(
+                "\\D",
+                ""
+        );
+    }
+
+    public static boolean isValid(
+            String cpf
+    ) {
+
+        String numeros =
+                normalize(cpf);
+
+        if (
+                numeros == null
+                || numeros.length() != 11
+        ) {
+            return false;
+        }
+
+        /*
+         * Rejeita 000.000.000-00, 111.111.111-11 etc.
+         */
+        if (
+                numeros.chars()
+                        .distinct()
+                        .count() == 1
+        ) {
+            return false;
+        }
+
+        return digito(numeros, 9) == numeros.charAt(9) - '0'
+                && digito(numeros, 10) == numeros.charAt(10) - '0';
+    }
+
+    private static int digito(
+            String numeros,
+            int quantidade
+    ) {
+
+        int soma = 0;
+
+        for (int i = 0; i < quantidade; i++) {
+            soma += (numeros.charAt(i) - '0') * (quantidade + 1 - i);
+        }
+
+        int resto = (soma * 10) % 11;
+
+        return resto == 10 ? 0 : resto;
+    }
+}
diff --git a/src/main/java/com/openfree_api/config/AjustesBancoConfig.java b/src/main/java/com/openfree_api/config/AjustesBancoConfig.java
new file mode 100644
index 0000000..4d7bb3d
--- /dev/null
+++ b/src/main/java/com/openfree_api/config/AjustesBancoConfig.java
@@ -0,0 +1,75 @@
+package com.openfree_api.config;
+
+import java.sql.Connection;
+import java.sql.Statement;
+
+import javax.sql.DataSource;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.boot.ApplicationArguments;
+import org.springframework.boot.ApplicationRunner;
+import org.springframework.stereotype.Component;
+
+/*
+ * Ajustes de banco que o "ddl-auto=update" do Hibernate
+ * não faz sozinho (ele cria colunas novas, mas nunca
+ * remove um NOT NULL de uma coluna que já existe).
+ *
+ * Todos os comandos podem rodar várias vezes sem efeito
+ * colateral. Se algum falhar, a API sobe mesmo assim e
+ * o erro aparece no log.
+ */
+@Component
+public class AjustesBancoConfig implements ApplicationRunner {
+
+    private static final Logger log =
+            LoggerFactory.getLogger(AjustesBancoConfig.class);
+
+    private static final String[] COMANDOS = {
+
+            /*
+             * Contratante pessoa física não tem CNPJ.
+             */
+            "ALTER TABLE empresas ALTER COLUMN cnpj DROP NOT NULL",
+
+            /*
+             * Empresas criadas antes do campo tipo_pessoa
+             * são todas PJ.
+             */
+            "UPDATE empresas SET tipo_pessoa = 'PJ' WHERE tipo_pessoa IS NULL"
+    };
+
+    private final DataSource dataSource;
+
+    public AjustesBancoConfig(
+            DataSource dataSource
+    ) {
+        this.dataSource = dataSource;
+    }
+
+    @Override
+    public void run(
+            ApplicationArguments args
+    ) {
+
+        for (String comando : COMANDOS) {
+
+            try (
+                    Connection connection = dataSource.getConnection();
+                    Statement statement = connection.createStatement()
+            ) {
+
+                statement.execute(comando);
+
+            } catch (Exception exception) {
+
+                log.warn(
+                        "Ajuste de banco não aplicado: '{}'. Motivo: {}",
+                        comando,
+                        exception.getMessage()
+                );
+            }
+        }
+    }
+}
