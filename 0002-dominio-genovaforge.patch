From f62eef61743ea744daf3ad89657efe5a3698968d Mon Sep 17 00:00:00 2001
From: Murillo <murillogf202@gmail.com>
Date: Mon, 5 Oct 2026 11:16:29 -0300
Subject: [PATCH 2/2] chore: migra URLs para openfree.genovaforge.com.br

- sitemap e link de recuperacao usam o novo dominio
- unifica a propriedade app.frontend.url

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01S8ASv6z5Kv294KDxbPprpR
---
 .../openfree_api/modules/auth/service/PasswordResetService.java | 2 +-
 .../openfree_api/modules/jobs/controller/SitemapController.java | 2 +-
 .../com/openfree_api/modules/jobs/service/SitemapService.java   | 2 +-
 src/main/resources/application-dev.properties                   | 2 +-
 src/main/resources/application-prod.properties                  | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/main/java/com/openfree_api/modules/auth/service/PasswordResetService.java b/src/main/java/com/openfree_api/modules/auth/service/PasswordResetService.java
index ed1ecff..6754c98 100644
--- a/src/main/java/com/openfree_api/modules/auth/service/PasswordResetService.java
+++ b/src/main/java/com/openfree_api/modules/auth/service/PasswordResetService.java
@@ -54,7 +54,7 @@ public class PasswordResetService {
     @Value("${app.password-reset.log-link:false}")
     private boolean logResetLink;
 
-    @Value("${app.frontend-url:http://localhost:4200}")
+    @Value("${app.frontend.url:http://localhost:4200}")
     private String frontendUrl;
 
     public PasswordResetService(
diff --git a/src/main/java/com/openfree_api/modules/jobs/controller/SitemapController.java b/src/main/java/com/openfree_api/modules/jobs/controller/SitemapController.java
index 6b05034..fd22cdd 100644
--- a/src/main/java/com/openfree_api/modules/jobs/controller/SitemapController.java
+++ b/src/main/java/com/openfree_api/modules/jobs/controller/SitemapController.java
@@ -30,7 +30,7 @@ public class SitemapController {
      * Endpoint interno que será exposto no
      * frontend como:
      *
-     * https://openfree-front.vercel.app/sitemap.xml
+     * https://openfree.genovaforge.com.br/sitemap.xml
      *
      * através de um rewrite da Vercel.
      *
diff --git a/src/main/java/com/openfree_api/modules/jobs/service/SitemapService.java b/src/main/java/com/openfree_api/modules/jobs/service/SitemapService.java
index 8ae0d07..99f5e3f 100644
--- a/src/main/java/com/openfree_api/modules/jobs/service/SitemapService.java
+++ b/src/main/java/com/openfree_api/modules/jobs/service/SitemapService.java
@@ -29,7 +29,7 @@ public class SitemapService {
 
 
     @Value(
-            "${app.frontend.url:https://openfree-front.vercel.app}"
+            "${app.frontend.url:https://openfree.genovaforge.com.br}"
     )
     private String frontendUrl;
 
diff --git a/src/main/resources/application-dev.properties b/src/main/resources/application-dev.properties
index 9f765c2..2e2ced6 100644
--- a/src/main/resources/application-dev.properties
+++ b/src/main/resources/application-dev.properties
@@ -70,4 +70,4 @@ springdoc.swagger-ui.enabled=true
 
 app.payments.simulation-enabled=true
 app.password-reset.log-link=true
-app.frontend-url=http://localhost:4200
+app.frontend.url=http://localhost:4200
diff --git a/src/main/resources/application-prod.properties b/src/main/resources/application-prod.properties
index f15b56c..57c8f24 100644
--- a/src/main/resources/application-prod.properties
+++ b/src/main/resources/application-prod.properties
@@ -70,4 +70,4 @@ springdoc.swagger-ui.enabled=false
 
 app.payments.simulation-enabled=false
 app.password-reset.log-link=false
-app.frontend-url=${OPENFREE_FRONTEND_URL}
+app.frontend.url=${OPENFREE_FRONTEND_URL:https://openfree.genovaforge.com.br}
